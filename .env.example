# Copy this file to .env on the server and fill it in:  cp .env.example .env
# Never commit .env to GitHub (it is in .gitignore).

# data.gov.in API key (data.gov.in -> Dashboard / My Account)
DATA_GOV_KEY=

# Datasets to scan, in this order (the ID after /resource/ on each dataset's API tab)
#   4dbe5667-...  MCA Company Master Data, all India (~37 lakh companies; most CPOs are here)
#   8b68ae56-...  MSME Udyam registrations, all India (~4.6 crore; smaller operators)
RESOURCE_IDS=4dbe5667-7b6b-41d7-82af-211562424d9a,8b68ae56-84cf-4728-a0a6-1be11028dea7

# What to look for: cpo (charge point operators), ev, energy, raw (no filter)
PROFILE=cpo

# ALL  = every state/UT, one at a time (big EV states first)
# NONE = scan each dataset in one pass without splitting by state
# or a list, e.g. STATES=MAHARASHTRA,KARNATAKA,DELHI
# Datasets without a "State" field (like MCA) are always scanned in one pass.
STATES=ALL
# Optional: only these districts inside each state (leave empty for all)
DISTRICTS=
# Extra exact-match filters, e.g. FILTERS=Pincode=411001
FILTERS=

# Politeness (keeps the API key safe from bans):
#   records per request (max 1000), seconds between requests (min 2),
#   and a daily request cap (resets at midnight IST; 0 = no cap)
PAGE_SIZE=1000
DELAY_SECONDS=4
MAX_REQUESTS_PER_DAY=10000

# Google Sheet that receives new leads (the long ID in the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Service account key file (download from Google Cloud, keep it off GitHub)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
